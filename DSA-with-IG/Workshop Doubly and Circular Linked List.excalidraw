      "isDeleted": false,
      "boundElements": null,
      "updated": 1772170716778,
      "link": null,
      "locked": false,
      "text": "    // Insert At first\n    public void insertAtFirst(int value){\n        if(size == 0){\n            insertAtLast(value);\n            return;\n        }\n        Node node = new Node(value);\n        tail.next = node;\n        node.next = head;\n        head = node;\n        size++;\n        return;\n    }",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    // Insert At first\n    public void insertAtFirst(int value){\n        if(size == 0){\n            insertAtLast(value);\n            return;\n        }\n        Node node = new Node(value);\n        tail.next = node;\n        node.next = head;\n        head = node;\n        size++;\n        return;\n    }",
      "autoResize": true,
      "lineHeight": 1.25
    },
