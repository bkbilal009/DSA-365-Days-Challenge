    {
      "id": "4xq6dbNj_I0WrkLfUUFs9",
      "type": "text",
      "x": 1301.0454078702114,
      "y": -3842.7246287024745,
      "width": 462.71966552734375,
      "height": 775,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2r",
      "roundness": null,
      "seed": 583576413,
      "version": 78,
      "versionNonce": 570280275,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1772169817036,
      "link": null,
      "locked": false,
      "text": "Insert at Index\n\n    // Insert At Index\n    public void insertAtIndex(int idx, int value){\n        if(idx == 0){\n            insertAtFirst(value);\n            return;\n        }\n        if(idx == size-1 || idx == size){\n            insertAtLast(value);\n            return;\n        }\n        if(idx > size || idx < 0){\n            System.out.println(\"Invalid Index\");\n            return;\n        }\n\n        Node node = new Node(value);\n        Node temp = head;\n        int count = 0;\n        while(count != idx-1){\n            temp = temp.next;\n            count++;\n        }\n        node.next = temp.next;\n        temp.next.prev = node;\n        temp.next = node;\n        node.prev = temp;\n        size++;\n        return;\n    }",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Insert at Index\n\n    // Insert At Index\n    public void insertAtIndex(int idx, int value){\n        if(idx == 0){\n            insertAtFirst(value);\n            return;\n        }\n        if(idx == size-1 || idx == size){\n            insertAtLast(value);\n            return;\n        }\n        if(idx > size || idx < 0){\n            System.out.println(\"Invalid Index\");\n            return;\n        }\n\n        Node node = new Node(value);\n        Node temp = head;\n        int count = 0;\n        while(count != idx-1){\n            temp = temp.next;\n            count++;\n        }\n        node.next = temp.next;\n        temp.next.prev = node;\n        temp.next = node;\n        node.prev = temp;\n        size++;\n        return;\n    }",
      "autoResize": true,
      "lineHeight": 1.25
    },
